{
  "schema": "reporting.evaluation_cases.v1",
  "description": "Public synthetic, hand-annotated tie-out cases. Mappings are supplied, not inferred. Expected amounts are independently specified, never generated by the tool.",
  "cases": [
    {
      "id": "asset-total-clean", "category": "totals",
      "rationale": "Cash 12,500,000 + receivables 1,250,000 + capital assets 48,750,000 = 62,500,000.",
      "reported": {"value": "62500000"},
      "supporting": [{"value": "12500000"}, {"value": "1250000"}, {"value": "48750000"}],
      "expected": {"status": "passed", "reported": "62500000.00", "expected": "62500000.00", "difference": "0.00"}
    },
    {
      "id": "asset-total-understated", "category": "totals",
      "rationale": "The same supported assets total 62,500,000; reported assets are understated by 10,000.",
      "reported": {"value": "62490000"},
      "supporting": [{"value": "12500000"}, {"value": "1250000"}, {"value": "48750000"}],
      "expected": {"status": "failed", "reported": "62490000.00", "expected": "62500000.00", "difference": "-10000.00"}
    },
    {
      "id": "cross-sheet-millions", "category": "units",
      "rationale": "4.200001 million is exactly 4,200,001 base units, not 4.20 million after premature rounding.",
      "reported": {"value": "4.200001", "scale": "millions"},
      "supporting": [{"value": "4200001"}],
      "expected": {"status": "passed", "reported": "4200001.00", "expected": "4200001.00", "difference": "0.00"}
    },
    {
      "id": "cross-sheet-small-discrepancy", "category": "units",
      "rationale": "4.201 thousand minus 4.2 thousand is a one-dollar discrepancy.",
      "reported": {"value": "4.201", "scale": "thousands"},
      "supporting": [{"value": "4.2", "scale": "thousands"}],
      "expected": {"status": "failed", "reported": "4201.00", "expected": "4200.00", "difference": "1.00"}
    },
    {
      "id": "rollforward-clean", "category": "rollforwards",
      "rationale": "800 thousand beginning balance + 30,000 additions - 10,000 reductions = 820,000.",
      "reported": {"value": "820000"},
      "supporting": [{"value": "800", "scale": "thousands"}, {"value": "30000"}, {"value": "10000", "sign": "subtract"}],
      "expected": {"status": "passed", "reported": "820000.00", "expected": "820000.00", "difference": "0.00"}
    },
    {
      "id": "rollforward-reduction-added", "category": "rollforwards",
      "rationale": "A reported balance of 840,000 incorrectly adds the reduction; correct ending balance is 820,000.",
      "reported": {"value": "840000"},
      "supporting": [{"value": "800", "scale": "thousands"}, {"value": "30000"}, {"value": "10000", "sign": "subtract"}],
      "expected": {"status": "failed", "reported": "840000.00", "expected": "820000.00", "difference": "20000.00"}
    },
    {
      "id": "accounting-negative", "category": "signs",
      "rationale": "125 plus a parenthesized negative 25 equals 100.",
      "reported": {"value": "100"},
      "supporting": [{"value": "125"}, {"value": "(25)"}],
      "expected": {"status": "passed", "reported": "100.00", "expected": "100.00", "difference": "0.00"}
    },
    {
      "id": "blank-is-not-zero", "category": "unavailable",
      "rationale": "An empty supporting cell is missing evidence even when treating it as zero would make the check pass.",
      "reported": {"value": "0"},
      "supporting": [{"value": ""}, {"value": "0"}],
      "expected": {"status": "not_evaluated"}
    },
    {
      "id": "dash-is-not-zero", "category": "unavailable",
      "rationale": "A dash might mean zero or missing; the declared parser does not guess.",
      "reported": {"value": "10"},
      "supporting": [{"value": "10"}, {"value": "-"}],
      "expected": {"status": "not_evaluated"}
    },
    {
      "id": "unresolved-formula", "category": "unavailable",
      "rationale": "A raw formula without a calculated numeric result cannot participate in the tie-out. FakeWorkiva leaves this formula uncalculated.",
      "reported": {"value": "20"},
      "supporting": [{"value": "=A1*2"}],
      "expected": {"status": "not_evaluated"}
    },
    {
      "id": "round-after-sum", "category": "rounding",
      "rationale": "0.005 + 0.005 equals 0.01. Rounding each operand first would incorrectly produce 0.02.",
      "reported": {"value": "0.01"},
      "supporting": [{"value": "0.005"}, {"value": "0.005"}],
      "expected": {"status": "passed", "reported": "0.01", "expected": "0.01", "difference": "0.00"}
    },
    {
      "id": "negative-half-up", "category": "rounding",
      "rationale": "HALF_UP rounds negative 0.025 to negative 0.03, rather than the HALF_EVEN result of negative 0.02.",
      "reported": {"value": "-0.03"},
      "supporting": [{"value": "-0.025"}],
      "expected": {"status": "passed", "reported": "-0.03", "expected": "-0.03", "difference": "0.00"}
    },
    {
      "id": "tolerance-inclusive-boundary", "category": "tolerance",
      "rationale": "A difference of exactly 0.02 is within an inclusive 0.02 tolerance.",
      "reported": {"value": "100.02"}, "supporting": [{"value": "100"}], "tolerance": "0.02",
      "expected": {"status": "passed", "reported": "100.02", "expected": "100.00", "difference": "0.02"}
    },
    {
      "id": "negative-outside-tolerance", "category": "tolerance",
      "rationale": "An absolute difference of 0.03 exceeds 0.02, even though the signed difference is negative.",
      "reported": {"value": "99.97"}, "supporting": [{"value": "100"}], "tolerance": "0.02",
      "expected": {"status": "failed", "reported": "99.97", "expected": "100.00", "difference": "-0.03"}
    },
    {
      "id": "malformed-grouping", "category": "unavailable",
      "rationale": "12,34 is not valid grouping; removing arbitrary commas would invent a passing value.",
      "reported": {"value": "1234"}, "supporting": [{"value": "12,34"}],
      "expected": {"status": "not_evaluated"}
    },
    {
      "id": "thousands-understatement", "category": "units",
      "rationale": "1.25 thousand is 1,250, one dollar below the supported 1,251.",
      "reported": {"value": "1.25", "scale": "thousands"}, "supporting": [{"value": "1251"}],
      "expected": {"status": "failed", "reported": "1250.00", "expected": "1251.00", "difference": "-1.00"}
    },
    {
      "id": "spreadsheet-reference-error", "category": "unavailable",
      "rationale": "A spreadsheet reference error is missing usable evidence, not a discrepancy amount.",
      "reported": {"value": "5"}, "supporting": [{"value": "#REF!"}],
      "expected": {"status": "not_evaluated"}
    },
    {
      "id": "large-value-small-cents", "category": "precision",
      "rationale": "The one-cent and two-cent components must survive alongside a 21-digit integer; binary floats would lose them.",
      "reported": {"value": "100000000000000000000.03"},
      "supporting": [{"value": "100000000000000000000.01"}, {"value": "0.02"}],
      "expected": {"status": "passed", "reported": "100000000000000000000.03", "expected": "100000000000000000000.03", "difference": "0.00"}
    }
  ]
}
